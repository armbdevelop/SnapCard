# SnapCard Configuration
SNAPCARD_DEBUG=false
SNAPCARD_DATABASE_URL=sqlite+aiosqlite:///./snapcard.db
SNAPCARD_UPLOAD_DIR=uploads
SNAPCARD_MAX_FILE_SIZE=10485760
SNAPCARD_DEVICE=cpu
SNAPCARD_MODEL_CACHE_DIR=./model_cache
